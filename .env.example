# Database
DATABASE_URL="
# Auth - Generate new secrets with: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# Email (Resend-compatible provider via the Resend SDK; MAIL_BASE_URL = custom endpoint)
MAIL_API_KEY=
MAIL_BASE_URL=
# Sender address (must be on a domain verified with the provider). Display name defaults to the site name.
MAIL_FROM="noreply@example.com"
MAIL_FROM_NAME=

# Contact inbox (privacy)
# If set, stores a salted hash of the client IP for spam/rate-limit patterns (the raw IP is never stored).
IP_HASH_SALT=

# AI suggested replies (OpenRouter)
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_APP_TITLE="Portfolio admin"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=

# Seed (optional)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_USERNAME="Admin"
SEED_ADMIN_PASSWORD="Admin123!"
